# Portas dos motores oficiais da Receita Federal (Docker Compose)
RTC_REGIME_REGULAR_PORT=8080
RTC_REGIME_REGULAR_MGMT_PORT=9101
RTC_SIMPLES_NACIONAL_PORT=8082
RTC_SIMPLES_NACIONAL_MGMT_PORT=9103
RTC_GERADOR_DANFSE_PORT=8083
DANFSE_LOG_LEVEL=info

# URLs consumidas pelo Backend/BFF (apps/api)
RTC_REGIME_REGULAR_URL=http://localhost:8080/api
RTC_SIMPLES_NACIONAL_URL=http://localhost:8082/api
RTC_GERADOR_DANFSE_URL=http://localhost:8083
RTC_REGIME_REGULAR_HEALTH_URL=http://localhost:9101/health
RTC_SIMPLES_NACIONAL_HEALTH_URL=http://localhost:9103/health

# Backend & Frontend (Fases 1-3)
API_PORT=3001
WEB_PORT=5173
APP_DB_PATH=./data/app.db

# Copiloto IA (Fase 3 - opcional)
# Valores suportados: gemini | openai | ollama
AI_PROVIDER=ollama
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

